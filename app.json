{
  "expo": {
    "name": "Books-expo",
    "slug": "books-expo",
    "version": "1.0.0",
    "scheme": "books-expo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1C1B1F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.books.expo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C1B1F"
      },
      "package": "com.books.expo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router"
    ]
  }
}
